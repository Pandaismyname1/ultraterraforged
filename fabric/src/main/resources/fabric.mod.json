{
  "schemaVersion": 1,
  "id": "reterraforged",
  "version": "${version}",
  "name": "ReTerraForged",
  "description": "A continuation of TerraForged (https://github.com/TerraForged/TerraForged): realistic, configurable terrain generation.",
  "authors": [
    "dags",
    "Won-Ton",
    "raccoonman",
    "Steveplays28",
    "EdoEquin0x"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "raccoonman.reterraforged.fabric.RTFFabric"
    ]
  },
  "mixins": [
    "reterraforged-common.mixins.json",
    "reterraforged-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=17"
  }
}
